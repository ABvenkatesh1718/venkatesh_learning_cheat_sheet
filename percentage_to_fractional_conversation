<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aptitude Fractions Master Reference</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #0f172a; /* Deep Slate Background */
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }
        .master-board {
            background-color: #1e293b; /* Uniform Dark Board Inner Container */
            border: 1px solid #334155;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            overflow: hidden;
        }
        .table-dark-custom {
            --bs-table-bg: transparent;
            --bs-table-color: #f8fafc;
            margin-bottom: 0;
        }
        .table-dark-custom td {
            padding: 16px 24px;
            font-size: 1.35rem;
            font-weight: 700;
            text-align: center;
            border-color: #334155;
            vertical-align: middle;
            color: #f8fafc !important; /* Forces text to stay clean white always */
        }
        /* Style for Column 3 border to keep it boxed exactly like the board without color highlighting */
        .boxed-column {
            border-left: 2px dashed #475569 !important;
            border-right: 2px dashed #475569 !important;
        }
        /* Fixed hover behavior so row text doesn't clash with dark styling */
        .table-dark-custom tbody tr:hover {
            background-color: #243249 !important; /* Shifts to a subtle blue-grey shade when hovered */
        }
        .empty-dash {
            color: #475569 !important; /* Keeps the dash symbols naturally dimmed out */
            font-weight: 400;
        }
    </style>
</head>
<body>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            
            <div class="master-board p-2">
                <table class="table table-dark-custom table-bordered">
                    <tbody>
                        <tr>
                            <td>1/2 = 50%</td>
                            <td>1/6 = 16.66%</td>
                            <td class="boxed-column">1/8 = 12.5%</td>
                            <td>1/9 = 11.11%</td>
                            <td>1/11 = 9.09%</td>
                        </tr>
                        <tr>
                            <td>1/3 = 33.33%</td>
                            <td>5/6 = 83.33%</td>
                            <td class="boxed-column">3/8 = 37.5%</td>
                            <td>2/9 = 22.22%</td>
                            <td>2/11 = 18.18%</td>
                        </tr>
                        <tr>
                            <td>2/3 = 66.66%</td>
                            <td>1/7 = 14.28%</td>
                            <td class="boxed-column">5/8 = 62.5%</td>
                            <td>3/9 = 33.33%</td>
                            <td>3/11 = 27.27%</td>
                        </tr>
                        <tr>
                            <td>1/4 = 25%</td>
                            <td>2/7 = 28.57%</td>
                            <td class="boxed-column">7/8 = 87.5%</td>
                            <td>4/9 = 44.44%</td>
                            <td>4/11 = 36.36%</td>
                        </tr>
                        <tr>
                            <td>3/4 = 75%</td>
                            <td>3/7 = 42.85%</td>
                            <td class="boxed-column">1/12 = 8.33%</td>
                            <td>5/9 = 55.55%</td>
                            <td>5/11 = 45.45%</td>
                        </tr>
                        <tr>
                            <td>1/5 = 20%</td>
                            <td>4/7 = 57.14%</td>
                            <td class="boxed-column">5/12 = 41.66%</td>
                            <td>6/9 = 66.66%</td>
                            <td>6/11 = 54.54%</td>
                        </tr>
                        <tr>
                            <td>2/5 = 40%</td>
                            <td>5/7 = 71.42%</td>
                            <td class="boxed-column">7/12 = 58.33%</td>
                            <td>7/9 = 77.77%</td>
                            <td>7/11 = 63.63%</td>
                        </tr>
                        <tr>
                            <td>3/5 = 60%</td>
                            <td>6/7 = 85.71%</td>
                            <td class="boxed-column">11/12 = 91.66%</td>
                            <td>8/9 = 88.88%</td>
                            <td>8/11 = 72.72%</td>
                        </tr>
                        <tr>
                            <td>4/5 = 80%</td>
                            <td class="empty-dash">-</td>
                            <td class="boxed-column empty-dash">-</td>
                            <td>1/10 = 10%</td>
                            <td>9/11 = 81.81%</td>
                        </tr>
                        <tr>
                            <td class="empty-dash">-</td>
                            <td class="empty-dash">-</td>
                            <td class="boxed-column empty-dash">-</td>
                            <td>2/10 = 20%</td>
                            <td>10/11 = 90.90%</td>
                        </tr>
                        <tr>
                            <td class="empty-dash">-</td>
                            <td class="empty-dash">-</td>
                            <td class="boxed-column empty-dash">-</td>
                            <td>3/10 = 30%</td>
                            <td class="empty-dash">-</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS Bundle CDN -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
