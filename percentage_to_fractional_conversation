<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aptitude Fractions Master Reference</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #0f172a; /* Deep Slate Background */
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }
        .master-board {
            background-color: #1e293b; /* Slate Board Container */
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .board-grid {
            display: flex;
            flex-direction: row;
            justify-content: center;
            gap: 24px;
            overflow-x: auto;
        }
        /* The Family Box: Wraps the entire column from header down to the last row */
        .family-box {
            background-color: #1a2333; /* Darker tone inside the column box */
            border: 2px solid #475569; /* Solid accent outline around the whole family */
            border-radius: 12px;
            min-width: 200px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        /* Family Header Style */
        .family-header {
            background-color: #334155;
            color: #38bdf8; /* Premium Sky Blue for Headings */
            font-size: 1.15rem;
            font-weight: 800;
            text-align: center;
            padding: 16px 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #475569;
        }
        /* Items Area inside the family box */
        .family-body {
            display: flex;
            flex-direction: column;
            padding: 10px 0;
        }
        /* No row borders, completely clean layout inside */
        .family-item {
            padding: 14px 20px;
            font-size: 1.35rem;
            font-weight: 700;
            text-align: center;
            color: #f8fafc;
            white-space: nowrap;
            transition: background-color 0.2s ease;
        }
        /* Line tracing highlight that stays strictly inside its own family column box */
        .family-item:hover {
            background-color: #243249; 
        }
        .empty-dash {
            color: #475569; /* Mutes empty dash cells completely */
            font-weight: 400;
        }
    </style>
</head>
<body>

<div class="container-fluid my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xxl-11">
            
            <div class="master-board">
                <div class="board-grid">
                    
                    <div class="family-box">
                        <div class="family-header">Base Multiples</div>
                        <div class="family-body">
                            <div class="family-item">1/2 = 50%</div>
                            <div class="family-item">1/3 = 33.33%</div>
                            <div class="family-item">2/3 = 66.66%</div>
                            <div class="family-item">1/4 = 25%</div>
                            <div class="family-item">3/4 = 75%</div>
                            <div class="family-item">1/5 = 20%</div>
                            <div class="family-item">2/5 = 40%</div>
                            <div class="family-item">3/5 = 60%</div>
                            <div class="family-item">4/5 = 80%</div>
                            <div class="family-item empty-dash">-</div>
                            <div class="family-item empty-dash">-</div>
                        </div>
                    </div>

                    <div class="family-box">
                        <div class="family-header">6 & 7 Families</div>
                        <div class="family-body">
                            <div class="family-item">1/6 = 16.66%</div>
                            <div class="family-item">5/6 = 83.33%</div>
                            <div class="family-item">1/7 = 14.28%</div>
                            <div class="family-item">2/7 = 28.57%</div>
                            <div class="family-item">3/7 = 42.85%</div>
                            <div class="family-item">4/7 = 57.14%</div>
                            <div class="family-item">5/7 = 71.42%</div>
                            <div class="family-item">6/7 = 85.71%</div>
                            <div class="family-item empty-dash">-</div>
                            <div class="family-item empty-dash">-</div>
                            <div class="family-item empty-dash">-</div>
                        </div>
                    </div>

                    <div class="family-box">
                        <div class="family-header">8 & 12 Families</div>
                        <div class="family-body">
                            <div class="family-item">1/8 = 12.5%</div>
                            <div class="family-item">3/8 = 37.5%</div>
                            <div class="family-item">5/8 = 62.5%</div>
                            <div class="family-item">7/8 = 87.5%</div>
                            <div class="family-item">1/12 = 8.33%</div>
                            <div class="family-item">5/12 = 41.66%</div>
                            <div class="family-item">7/12 = 58.33%</div>
                            <div class="family-item">11/12 = 91.66%</div>
                            <div class="family-item empty-dash">-</div>
                            <div class="family-item empty-dash">-</div>
                            <div class="family-item empty-dash">-</div>
                        </div>
                    </div>

                    <div class="family-box">
                        <div class="family-header">9 & 10 Families</div>
                        <div class="family-body">
                            <div class="family-item">1/9 = 11.11%</div>
                            <div class="family-item">2/9 = 22.22%</div>
                            <div class="family-item">3/9 = 33.33%</div>
                            <div class="family-item">4/9 = 44.44%</div>
                            <div class="family-item">5/9 = 55.55%</div>
                            <div class="family-item">6/9 = 66.66%</div>
                            <div class="family-item">7/9 = 77.77%</div>
                            <div class="family-item">8/9 = 88.88%</div>
                            <div class="family-item">1/10 = 10%</div>
                            <div class="family-item">2/10 = 20%</div>
                            <div class="family-item">3/10 = 30%</div>
                        </div>
                    </div>

                    <div class="family-box">
                        <div class="family-header">11 Family</div>
                        <div class="family-body">
                            <div class="family-item">1/11 = 9.09%</div>
                            <div class="family-item">2/11 = 18.18%</div>
                            <div class="family-item">3/11 = 27.27%</div>
                            <div class="family-item">4/11 = 36.36%</div>
                            <div class="family-item">5/11 = 45.45%</div>
                            <div class="family-item">6/11 = 54.54%</div>
                            <div class="family-item">7/11 = 63.63%</div>
                            <div class="family-item">8/11 = 72.72%</div>
                            <div class="family-item">9/11 = 81.81%</div>
                            <div class="family-item">10/11 = 90.90%</div>
                            <div class="family-item empty-dash">-</div>
                        </div>
                    </div>

                </div>
            </div>
            
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
